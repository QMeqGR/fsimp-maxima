matchdeclare(fs_pa,true)$
/* half angle formulae */
matchdeclare(fs_pb,lambda([x],freeof(cos(fs_pa),sin(fs_pa),x)))$
defrule(fs_tr001, fs_pb*(1-cos(fs_pa))/2 , fs_pb*sin(fs_pa/2)^2 )$
defrule(fs_tr002, fs_pb*(1+cos(fs_pa))/2 , fs_pb*cos(fs_pa/2)^2 )$
defrule(fs_tr003, fs_pb*(1-cos(fs_pa))/sin(fs_pa) , fs_pb*tan(fs_pa/2) )$
defrule(fs_tr004, fs_pb*(1+cos(fs_pa))/sin(fs_pa) , fs_pb*cot(fs_pa/2) )$
defrule(fs_tr005, fs_pb*2/(1+cos(fs_pa)) , fs_pb*sec(fs_pa/2)^2 )$
defrule(fs_tr006, fs_pb*2/(1-cos(fs_pa)) , fs_pb*csc(fs_pa/2)^2 )$

defrule(fs_tr007, fs_pb*(-1+cos(fs_pa))/2 , -fs_pb*sin(fs_pa/2)^2 )$
defrule(fs_tr008, fs_pb*(-1-cos(fs_pa))/2 , -fs_pb*cos(fs_pa/2)^2 )$
defrule(fs_tr009, fs_pb*(-1+cos(fs_pa))/sin(fs_pa) , -fs_pb*tan(fs_pa/2) )$
defrule(fs_tr010, fs_pb*(-1-cos(fs_pa))/sin(fs_pa) , -fs_pb*cot(fs_pa/2) )$
defrule(fs_tr011, fs_pb*2/(-1-cos(fs_pa)) , -fs_pb*sec(fs_pa/2)^2 )$
defrule(fs_tr012, fs_pb*2/(-1+cos(fs_pa)) , -fs_pb*csc(fs_pa/2)^2 )$

/* double angle formulae */
matchdeclare(fs_pb,lambda([x],freeof(tan(fs_pa),x)))$
defrule(fs_tr101, fs_pb*2*tan(fs_pa)/(1-tan(fs_pa)^2), fs_pb*tan(2*fs_pa) )$
defrule(fs_tr102, fs_pb*(1-tan(fs_pa)^2)/(2*tan(fs_pa)), fs_pb*cot(2*fs_pa) )$
defrule(fs_tr103, fs_pb*(1+tan(fs_pa)^2)/(1-tan(fs_pa)^2), fs_pb*sec(2*fs_pa) )$
defrule(fs_tr104, fs_pb*(1+tan(fs_pa)^2)/(2*tan(fs_pa)), fs_pb*csc(2*fs_pa) )$

defrule(fs_tr105, 2*tan(fs_pa)/(-1+tan(fs_pa)^2), -tan(2*fs_pa) )$
defrule(fs_tr106, fs_pb*(-1+tan(fs_pa)^2)/(2*tan(fs_pa)), -fs_pb*cot(2*fs_pa) )$
defrule(fs_tr107, fs_pb*(1+tan(fs_pa)^2)/(-1+tan(fs_pa)^2), -fs_pb*sec(2*fs_pa) )$
defrule(fs_tr108, fs_pb*(-1-tan(fs_pa)^2)/(2*tan(fs_pa)), -fs_pb*csc(2*fs_pa) )$

/* exponentials */
matchdeclare(fs_pb,lambda([x],freeof(cos(fs_pa),sin(fs_pa),x)))$
defrule(fs_tr201, fs_pb*(cos(fs_pa)+%i*sin(fs_pa)) , fs_pb*exp(%i*fs_pa) )$
defrule(fs_tr202, fs_pb*(cos(fs_pa)-%i*sin(fs_pa)) , fs_pb*exp(-%i*fs_pa) )$
defrule(fs_tr203, fs_pb*(-cos(fs_pa)+%i*sin(fs_pa)) , -fs_pb*exp(-%i*fs_pa) )$

/* csc and cot rules */
matchdeclare(fs_pb,lambda([x],freeof(cos(fs_pa),sin(fs_pa),csc(fs_pa),cot(fs_pa),x)))$
defrule(fs_tr301, fs_pb*(csc(fs_pa)^2-cot(fs_pa)^2), fs_pb)$
matchdeclare(fs_pb,lambda([x],freeof(tan(fs_pa),cot(fs_pa),x)))$
defrule(fs_tr302, fs_pb*(tan(fs_pa)+cot(fs_pa)), fs_pb*2*csc(2*fs_pa) )$
defrule(fs_tr303, fs_pb*(cot(fs_pa)-tan(fs_pa)), fs_pb*2*cot(2*fs_pa) )$

/* hyperbolic */
/* matchdeclare([fs_pb,fs_pz],all)$ */
matchdeclare(fs_pb,all,fs_pz,freeof(%i))$
defrule(fs_tr401, fs_pb*(%e^fs_pz-%e^-fs_pz)/(%e^fs_pz+%e^-fs_pz), fs_pb*tanh(fs_pz) )$
defrule(fs_tr402, fs_pb*(%e^(2*fs_pz)-1)/(%e^(2*fs_pz)+1), fs_pb*tanh(fs_pz) )$
defrule(fs_tr403, fs_pb*(%e^fs_pz+%e^-fs_pz)/2, fs_pb*cosh(fs_pz) )$
defrule(fs_tr404, fs_pb*(%e^fs_pz-%e^-fs_pz)/2, fs_pb*sinh(fs_pz) )$
defrule(fs_tr405, fs_pb*sinh(fs_pz)/cosh(fs_pz),fs_pb*tanh(fs_pz) )$


fs_trig_rules:[fs_tr001,fs_tr002,fs_tr003,fs_tr004,fs_tr005,fs_tr006,
fs_tr007,fs_tr008,fs_tr009,fs_tr010,fs_tr011,fs_tr012,
fs_tr101,fs_tr102,fs_tr103,fs_tr104,fs_tr105,fs_tr106,fs_tr107,fs_tr108,
fs_tr201,fs_tr202,fs_tr203,
fs_tr301,fs_tr302,fs_tr303,
fs_tr401,fs_tr402,fs_tr403,fs_tr404,fs_tr405]$


/***************************************/
/*         fstrigsimp()                */
/***************************************/
/* This function cycles through the trig rules above and,
if the substitution reduces the size of the expression,
takes the substitution.

apply1 evaluates its first argument, so it gets the quoted 'e and
evaluates that to the expression. Passing the expression itself would
evaluate it a second time, and any variable in it that shares a name with
a local variable of a calling function (p, r, i, e, ...) would take that
local's value.
*/
fstrigsimp(e):=block([fsrulesN:length(fs_trig_rules),Li,tmp,tmpsz],
    Li:fssize(e),
    if fsdebug>2 then print(e),
    for i: 1 thru fsrulesN do
      ( if fsdebug>1 then print("trying rule ",fs_trig_rules[i] ),
        tmp: apply('apply1,['e,fs_trig_rules[i]]),
        tmpsz: fssize(tmp),
        if tmpsz<Li then (
          if fsdebug>1 then (print("trgrule: ",fs_trig_rules[i]),print("tmp= ",tmp)),
          Li:tmpsz, e:tmp)),
    e
)$
